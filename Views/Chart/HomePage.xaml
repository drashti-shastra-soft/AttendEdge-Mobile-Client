            ZoomMode="X" />-->


            <sf:SfDataGrid
                x:Name="sfGrdDatas"
                AllowResizingColumns="True"
                AutoGenerateColumnsMode="None"
                ColumnWidthMode="Auto"
                GridLinesVisibility="Both"
                HeaderGridLinesVisibility="Both"
                IsVisible="False">
                <sf:SfDataGrid.DefaultStyle>
                    <sf:DataGridStyle
                        HeaderRowFontSize="16"
                        RowFontFamily="Regular"
                        RowFontSize="14" />
                </sf:SfDataGrid.DefaultStyle>

                <sf:SfDataGrid.Columns>
                    <sf:DataGridTextColumn HeaderText="ID" MappingName="Id" />

                    <sf:DataGridTextColumn
                        CellTextAlignment="Justify"
                        HeaderText="Name"
                        MappingName="Name" />

                    <sf:DataGridTextColumn HeaderText="Department" MappingName="Department" />

                    <sf:DataGridNumericColumn
                        Format="D"
                        HeaderText="Salary"
                        MappingName="Salary" />
                    <sf:DataGridNumericColumn
                        Format="D"
                        HeaderText="Address"
                        MappingName="Address" />
                </sf:SfDataGrid.Columns>

            </sf:SfDataGrid>


            <FlexLayout
                Margin="15"
                AlignItems="Start"
                Direction="Row"
                FlexLayout.AlignSelf="Auto"
                IsVisible="false"
                JustifyContent="Start"
                Wrap="Wrap">
                <Border
                    Margin="0,0,5,0"
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            Style="{StaticResource lblRegular}"
                            Text="Zone"
                            TextColor="White" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="10"
                            Source="icon_down_arrow.png"
                            WidthRequest="10" />
                    </Grid>
                </Border>

                <Border
                    Margin="0,0,5,0"
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            Style="{StaticResource lblRegular}"
                            Text="Division"
                            TextColor="White" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="10"
                            Source="icon_down_arrow.png"
                            WidthRequest="10" />
                    </Grid>
                </Border>
                <Border
                    Margin="0,0,5,8"
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            Style="{StaticResource lblRegular}"
                            Text="Station"
                            TextColor="White" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="10"
                            Source="icon_down_arrow.png"
                            WidthRequest="10" />
                    </Grid>
                </Border>
                <Border
                    Margin="0,0,0,0"
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            Style="{StaticResource lblRegular}"
                            Text="Asset Type"
                            TextColor="White" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="10"
                            Source="icon_down_arrow.png"
                            WidthRequest="10" />
                    </Grid>
                </Border>
                <Border
                    Margin="0,0,5,0"
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    HorizontalOptions="Start"
                    StrokeShape="{RoundRectangle CornerRadius=10}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            Style="{StaticResource lblRegular}"
                            Text="Alert Type"
                            TextColor="White" />
                        <Image
                            Grid.Column="1"
                            Aspect="AspectFit"
                            HeightRequest="10"
                            Source="icon_down_arrow.png"
                            WidthRequest="10" />
                    </Grid>
                </Border>

                <Border
                    Padding="12,10"
                    BackgroundColor="{StaticResource Primary}"
                    HorizontalOptions="End"
                    StrokeShape="{RoundRectangle CornerRadius=8}">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="16"
                        Source="icon_tab_five_black.png"
                        WidthRequest="16" />
                </Border>
            </FlexLayout>

