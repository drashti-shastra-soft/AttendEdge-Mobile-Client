<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AttendEdgeMobileClient.Views.Tapped.HolidayView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:conv="clr-namespace:AttendEdgeMobileClient.Converter">
    <ContentView.Resources>
        <ResourceDictionary>
            <conv:HolidayDateToBGColorConverter x:Key="HolidayDateToBGColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <RefreshView
        x:Name="HolidayRefreshView"
        Grid.Row="1"
        RefreshColor="#2F80ED"
        Refreshing="OnRefreshing">
        <Grid RowDefinitions="Auto,*">
            <Label
                Grid.Row="0"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Style="{StaticResource lblExtraBold}"
                Text="Holiday List"
                VerticalOptions="Center" />
            <CollectionView
                x:Name="lstHoliday"
                Grid.Row="1"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                
                <CollectionView.Header>
                    <BoxView BackgroundColor="Transparent" HeightRequest="12" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView BackgroundColor="Transparent" HeightRequest="12" />
                </CollectionView.Footer>

                <!--  Empty State  -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="40,60"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Border
                            Background="#E6F0FF"
                            HeightRequest="72"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 36"
                            StrokeThickness="0"
                            WidthRequest="72">
                            <Image
                                HeightRequest="36"
                                HorizontalOptions="Center"
                                Source="icon_tab_four_blue.png"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="#007BFF" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <Label
                            FontSize="16"
                            HorizontalOptions="Center"
                            Style="{StaticResource lblSemiBold}"
                            Text="No Holidays Found"
                            TextColor="#1A1A1A" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border 
                                Margin="0,10,0,10" 
                                Background="White"
                                Stroke="#EFEFEF"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="Black"
                                        Opacity="0.05"
                                        Radius="8"
                                        Offset="0,2" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="10,*">
                                    <!--<StackLayout Grid.Column="0" BackgroundColor="{Binding Date, 
                                    Converter={StaticResource HolidayDateToBGColorConverter}}" />-->
                                    <BoxView
                                        Grid.Column="0"
                                        BackgroundColor="{Binding Date, Converter={StaticResource HolidayDateToBGColorConverter}}" />
                                    <Grid
                                        Grid.Column="1"
                                        Padding="10"
                                        ColumnDefinitions="Auto,*"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="8">

                                        <StackLayout
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="25"
                                                Source="icon_calander.png"
                                                WidthRequest="25" />
                                            <Label
                                                FontSize="16"
                                                HorizontalOptions="Start"
                                                Style="{StaticResource lblSemiBold}"
                                                Text="{Binding Date, StringFormat='{0:dd MMM}'}"
                                                TextColor="{StaticResource Black}" />
                                        </StackLayout>

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="17"
                                            HorizontalOptions="End"
                                            Style="{StaticResource lblSemiBold}"
                                            Text="{Binding Date, StringFormat='{0:dddd}'}"
                                            TextColor="{StaticResource Black}" />


                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            FontSize="15"
                                            HorizontalOptions="Start"
                                            VerticalTextAlignment="Center"
                                            Style="{StaticResource lblBold}"
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource Black}" />

                                        <!--<Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            BackgroundColor="#E6F0FF"
                                            StrokeThickness="0"
                                            Padding="10,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label
                                                Text="Full Day"
                                                TextColor="#007BFF"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>-->

                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="#E6F0FF"
                                            StrokeThickness="0"
                                            Padding="10,6">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="Full Day"
                                                TextColor="#007BFF"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center">

                                                <Label.Triggers>

                                                    <!-- IsHalfDay = true -->
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsHalfDay}"
                                                        Value="True">

                                                        <Setter Property="Text" Value="Half Day" />
                                                        <Setter Property="TextColor" Value="#E6A900" />

                                                    </DataTrigger>

                                                </Label.Triggers>
                                            </Label>

                                            <Border.Triggers>

                                                <!-- IsHalfDay = true -->
                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding IsHalfDay}"
                                                    Value="True">

                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="#FFF4CC" />

                                                </DataTrigger>

                                            </Border.Triggers>

                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentView>
