<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AttendEdgeMobileClient.Views.Account.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:AttendEdgeMobileClient.CustomeControls"
    NavigationPage.HasBackButton="False"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid
            Margin="0"
            Padding="20"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="20">
            <!--<Image Aspect="AspectFit" Source="img_bg" />-->

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="25"
                HorizontalOptions="Start"
                Source="icon_back"
                Style="{StaticResource ImgSmall}"
                VerticalOptions="Start"
                WidthRequest="25">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ImgBack_Tapped" />
                </Image.GestureRecognizers>
            </Image>

            <Image
                Grid.Row="1"
                Aspect="AspectFit"
                HeightRequest="250"
                Source="img_forgot_password"
                WidthRequest="250" />

            <StackLayout Grid.Row="2">

                <Label
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblBold}"
                    Text="Forgot Password" />

                <Label
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    LineHeight="1"
                    Style="{StaticResource lblRegular}"
                    Text="Reset your password to continue"
                    TextColor="{StaticResource AppGray}" />
            </StackLayout>

            <Border
                Grid.Row="3"
                Margin="0,0"
                Padding="0"
                Stroke="{StaticResource Primary}"
                StrokeShape="{RoundRectangle CornerRadius=8}">
                <Grid
                    Margin="0"
                    Padding="10,0"
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="0">
                    <Label
                        Grid.Row="0"
                        Margin="0,8,0,0"
                        FontSize="16"
                        Style="{StaticResource lblSemiBold}"
                        Text="Email Address"
                        TextColor="{StaticResource Primary}" />
                    <ext:BorderlessEntry
                        x:Name="TxtEmailAddress"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,-5,5,0"
                        FontSize="16"
                        Keyboard="Email"
                        HeightRequest="40"
                        Placeholder="sampleemail16@exa.com"
                        Style="{StaticResource extEntry}" />
                    <Image
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Aspect="AspectFit"
                        BackgroundColor="Transparent"
                        HeightRequest="25"
                        Source="icon_email.png"
                        WidthRequest="25" />
                </Grid>
            </Border>

            <!--<Button
                Grid.Row="4"
                Margin="0,30,0,0"
                Clicked="BtnSendCode_Tapped"
                Style="{StaticResource BtnPrimary}"
                Text="Submit" />-->

            <Button
                x:Name="BtnContinue"
                Grid.Row="4"
                Margin="0,30,0,0"
                Clicked="BtnContinue_Clicked"
                Style="{StaticResource btnPrimary}"
                Text="Continue" />
        </Grid>
    </ScrollView>

