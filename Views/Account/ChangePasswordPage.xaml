<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AttendEdgeMobileClient.Views.Account.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:AttendEdgeMobileClient.CustomeControls"
    NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <Grid
            Margin="20,10"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="20">

            <StackLayout Grid.Row="0" Orientation="Horizontal">
                <Image
                    Aspect="AspectFit"
                    BackgroundColor="Transparent"
                    HeightRequest="30"
                    HorizontalOptions="Start"
                    Source="icon_back.png"
                    WidthRequest="30">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ImgBack_Tapped" />
                    </Image.GestureRecognizers>
                </Image>

                <!--<Label
                    FontSize="20"
                    HorizontalOptions="CenterAndExpand"
                    Style="{StaticResource lblExtraBold}"
                    Text="Change Your Password"
                    VerticalOptions="Center" />-->
            </StackLayout>

            <Grid
                Grid.Row="1"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="20">

                <Image
                    Grid.Row="0"
                    Aspect="AspectFit"
                    HeightRequest="250"
                    Source="img_change_password.png"
                    WidthRequest="300" />
                <StackLayout Grid.Row="1">

                    <Label
                        FontSize="22"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource lblBold}"
                        Text="Change Your Password" />

                    <Label
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        LineHeight="1"
                        Style="{StaticResource lblRegular}"
                        Text="You Can Now Change Your Password"
                        TextColor="{StaticResource AppGray}" />
                </StackLayout>

                <Border
                    Grid.Row="2"
                    Padding="0"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=8}">
                    <Grid
                        Padding="10,0"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="0">
                        <Label
                            Grid.Row="0"
                            Margin="0,8,0,0"
                            FontSize="16"
                            Style="{StaticResource lblSemiBold}"
                            Text="Current Password"
                            TextColor="{StaticResource Primary}" />

                        <ext:BorderlessEntry
                            x:Name="txtCurrentPassword"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Next"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,-5,5,0"
                            FontSize="16"
                            PlaceholderColor="{StaticResource Black}"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="ImgCurrentPasswordEye"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="25"
                            Source="icon_hide.png"
                            VerticalOptions="Center"
                            WidthRequest="25">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ImgCurrentPasswordEye_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="3"
                    Padding="0"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=8}">
                    <Grid
                        Padding="10,0"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="0">
                        <Label
                            Grid.Row="0"
                            Margin="0,8,0,0"
                            FontSize="16"
                            Style="{StaticResource lblSemiBold}"
                            Text="New Password"
                            TextColor="{StaticResource Primary}" />

                        <ext:BorderlessEntry
                            x:Name="TxtNewPassword"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,-5,5,0"
                            FontSize="16"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Next"
                            PlaceholderColor="{StaticResource Black}"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="ImgNewPasswordEye"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="25"
                            Source="icon_hide.png"
                            VerticalOptions="Center"
                            WidthRequest="25">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ImgNewPasswordEye_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    Padding="0"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="{RoundRectangle CornerRadius=8}">
                    <Grid
                        Padding="10,0"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="0">
                        <Label
                            Grid.Row="0"
                            Margin="0,8,0,0"
                            FontSize="16"
                            Style="{StaticResource lblSemiBold}"
                            Text="Confirm New Password"
                            TextColor="{StaticResource Primary}" />

                        <ext:BorderlessEntry
                            x:Name="TxtConfirmPassword"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,-5,5,0"
                            FontSize="16"
                            IsPassword="True"
                            Placeholder="********"
                            ReturnType="Done"
                            PlaceholderColor="{StaticResource Black}"
                            Style="{StaticResource extEntry}" />
                        <Image
                            x:Name="ImgConfirmEye"
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="25"
                            Source="icon_hide.png"
                            VerticalOptions="Center"
                            WidthRequest="25">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="ImgConfirmPasswordEye_Tapped" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>
            </Grid>

            <Button
                x:Name="BtnUpdate"
                Grid.Row="2"
                BackgroundColor="{StaticResource Primary}"
                Clicked="BtnUpdate_Clicked"
                Style="{StaticResource btnPrimary}"
                Text="Update"
                VerticalOptions="End" />
        </Grid>

    </ScrollView>
</ContentPage>