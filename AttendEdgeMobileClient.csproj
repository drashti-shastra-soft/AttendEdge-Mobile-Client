<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--net9.0-ios;net9.0-android-->
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>AttendEdgeMobileClient</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		
		<!-- Display name -->
		<ApplicationTitle>AttendEdgeMobileClient</ApplicationTitle>
		
		<!-- App Identifier -->
		<ApplicationId>com.shastrasoft.attendedge</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<AndroidSigningKeyStore>Platforms\Android\Keystore\attendedge.keystore</AndroidSigningKeyStore>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>test123</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>attendedge</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>test123</AndroidSigningKeyPass>
		<Debugger>Xamarin</Debugger>
		<NoWarn>1701;1702;</NoWarn>
		<MtouchFastDev>false</MtouchFastDev>
		<UseInterpreter>true</UseInterpreter>
		<MtouchUseLlvm>false</MtouchUseLlvm>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>test123</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>attendedge</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>test123</AndroidSigningKeyPass>
		<RunAOTCompilation>false</RunAOTCompilation>
		<UseInterpreter>true</UseInterpreter>
		<MauiEnableMarkupCompile>false</MauiEnableMarkupCompile>
		<MauiEnableHotReload>true</MauiEnableHotReload>
		<AndroidLinkMode>None</AndroidLinkMode>
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
		<Debugger>Xamarin</Debugger>
		<NoWarn>1701;1702;</NoWarn>
		<UseLLVM>false</UseLLVM>
		<MtouchFastDev>false</MtouchFastDev>
		<UseInterpreter>true</UseInterpreter>
		<MtouchUseLlvm>false</MtouchUseLlvm>
		<AndroidEnableFastDeployment>true</AndroidEnableFastDeployment>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-ios|AnyCPU'">
		<MtouchDebug>True</MtouchDebug>
		<NoWarn>1701;1702;</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-ios' and '$(Configuration)' == 'Release'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<ProvisioningType>manual</ProvisioningType>
		<CodesignKey>iPhone Distribution: Prignesh Modi (RN53TJDX3A)</CodesignKey>
		<CodesignProvision>AttendEdge-AdHoc-11-05-2025</CodesignProvision>
		<CodesignEntitlement>Entitlements.plist</CodesignEntitlement>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-ios'">
	  <ProvisioningType>manual</ProvisioningType>
	  <CodesignKey>iPhone Distribution: Prignesh Modi (RN53TJDX3A)</CodesignKey>
	  <CodesignProvision>AttendEdge-AdHoc-11-05-2025</CodesignProvision>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-ios|AnyCPU'">
	  <NoWarn>1701;1702;</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\new_app_icon_fixed.svg" Color="#FFFFFF"  />

		<!-- Splash Screen -->
		<!--<MauiSplashScreen Include="Resources\Splash\icon_login_logo.svg" Color="#FFFFFF"  />-->
		<MauiSplashScreen Include="Resources\Splash\new_icon_splash.svg" Color="#FFFFFF" BaseSize="128,128" />
		
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		
		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
	  <!--<None Remove="Resources\Splash\new_icon_splash.svg" />-->
	</ItemGroup>
	<ItemGroup>
